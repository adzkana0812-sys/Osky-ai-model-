{
  "model_name": "OSKY-AI-Large",
  "vocab_size": 8192,
  "hidden_dim": 1024,
  "num_layers": 16,
  "num_heads": 16,
  "max_seq_len": 1024,
  "ffn_dim": 4096,
  "dropout": 0.1,
  "norm_type": "rmsnorm",
  "use_rope": true,
  "tie_weights": true,
  "activation": "silu",
  "training": {
    "batch_size": 4,
    "gradient_accumulation_steps": 8,
    "learning_rate": 1.5e-4,
    "min_learning_rate": 1.5e-5,
    "warmup_steps": 500,
    "max_steps": 50000,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "eval_interval": 500,
    "eval_steps": 50,
    "save_interval": 2500,
    "seed": 42
  }
}
