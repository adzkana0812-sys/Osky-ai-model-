{
  "model_name": "OSKY-AI-Small",
  "vocab_size": 1024,
  "hidden_dim": 256,
  "num_layers": 4,
  "num_heads": 4,
  "max_seq_len": 256,
  "ffn_dim": 1024,
  "dropout": 0.1,
  "norm_type": "rmsnorm",
  "use_rope": true,
  "tie_weights": true,
  "activation": "silu",
  "training": {
    "batch_size": 16,
    "gradient_accumulation_steps": 2,
    "learning_rate": 5e-4,
    "min_learning_rate": 5e-5,
    "warmup_steps": 100,
    "max_steps": 2000,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "eval_interval": 100,
    "eval_steps": 20,
    "save_interval": 250,
    "seed": 42
  }
}
